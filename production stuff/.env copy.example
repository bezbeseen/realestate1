# This is an example file. Copy this to a new file named .env
# and fill in your actual values. The .env file should NOT be committed to git.

# Stripe (for checkout)
STRIPE_PUBLISHABLE_KEY=your_publishable_key_here
STRIPE_SECRET_KEY=your_secret_key_here

# Optional: Bluehost FTP for deploy-no-assets.sh (getbeseen.com)
# FTP_HOST=ftp.getbeseen.com
# FTP_USER=yourusername@getbeseen.com
# FTP_PATH=/public_html/
# FTP_PASS=your_ftp_password